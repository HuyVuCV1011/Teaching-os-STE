# Public Supabase values exposed to the browser by design
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only Supabase and application secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
JWT_SECRET=replace_with_at_least_32_random_characters
GRADING_SECRET_TOKEN=replace_with_a_random_callback_token

# Optional legacy symmetric JWT verification for old access-token cookies
SUPABASE_JWT_SECRET=

# Internal grading/AI services
RUBICORE_API_URL=http://localhost:8080
GEMINI_API_KEY=

# Development only. Never enable in production.
BYPASS_ADMIN_AUTH=false
